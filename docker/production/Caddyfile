{
	frankenphp
}

# SERVER_NAME = your domain (e.g. beszed.example.hu). Caddy gets and renews the
# HTTPS certificate itself; "localhost" uses its own local CA (for testing).
{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd br gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The recordings and the voice games need the microphone; Szájtorna's mirror the front camera
		# (shown and analysed on the device only, never sent).
		Permissions-Policy "camera=(self), geolocation=(), microphone=(self)"
		X-Frame-Options DENY
		-Server
		# Enable once the domain is final (browsers remember it for a year):
		# Strict-Transport-Security "max-age=31536000"
	}

	# Fingerprinted Vite output never changes.
	@hashed path /build/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Emoji pictures only change with a Twemoji upgrade.
	@emoji path /build/emoji/*
	header @emoji Cache-Control "public, max-age=2592000"

	# Szájtorna's face tracker (MediaPipe wasm + model, scripts/copy-face.mjs) changes only with an upgrade.
	@face path /build/face/*
	header @face Cache-Control "public, max-age=2592000"

	# The service worker must be re-checked on every visit, and so must what tells it a new build is out
	# (sw-version.js, imported by sw.js) and what it precaches from (manifest.json).
	@sw path /sw.js /build/sw-version.js /build/manifest.json
	header @sw Cache-Control "no-cache"

	php_server
}
