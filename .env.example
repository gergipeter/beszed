APP_NAME="Beszéd & DIFER"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1
TTS_DRIVER=null
# Free Hungarian server voice (installed in the Docker image; set it there): TTS_DRIVER=piper
# Optional Azure server voice:
# TTS_DRIVER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=hu-HU-NoemiNeural
# TTS_RATE=-10%
# TTS_PITCH=+8%
# Parent sign-in with Google (console.cloud.google.com → Credentials → OAuth client ID, "Web application").
# Authorized redirect URI: <APP_URL>/auth/google/callback, e.g. http://localhost:8000/auth/google/callback
# Empty = only the local demo sign-in (APP_ENV=local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Nightly SQLite snapshots (php artisan beszed:backup, scheduled 03:30): where, and how many days to keep.
# BACKUP_PATH=storage/app/backups
# BACKUP_KEEP_DAYS=14
# Parents (by e-mail, comma-separated) who may use the content editor (/tartalom). Only accounts whose
# e-mail is verified (Google sign-in, or a completed password reset) count.
ADMIN_EMAILS=parent@example.test
# Proxies whose X-Forwarded-For is believed (comma-separated addresses / ranges, or *). Empty = private
# networks and localhost only (a tunnel or load balancer on the same network). Behind Cloudflare, list its
# ranges here; "*" only if the app cannot be reached except through the proxy.
# TRUSTED_PROXIES=
# Day boundaries for streaks / the daily goal:
# BESZED_TIMEZONE=Europe/Budapest
STT_DRIVER=null
# Optional Azure pronunciation assessment (Mondd utánam), reuses AZURE_SPEECH_KEY/REGION above:
# STT_DRIVER=azure
# AZURE_SPEECH_STT_LANGUAGE=hu-HU
# Self-hosted Whisper large-v3 (Mondd utánam; the child's voice never leaves our server). Needs an
# OpenAI-compatible server (faster-whisper-server / speaches, whisper.cpp server) reachable at WHISPER_URL:
# STT_DRIVER=whisper
# WHISPER_URL=http://whisper:8000
# WHISPER_MODEL=Systran/faster-whisper-large-v3
# In-app premium subscription (Apple In-App Purchase / Google Play Billing through RevenueCat, docs/billing.md).
# Secret key: RevenueCat → Project settings → API keys → secret (sk_…); stays on the server.
# Webhook: RevenueCat → Integrations → Webhooks → URL <APP_URL>/api/webhooks/revenuecat, Authorization header = REVENUECAT_WEBHOOK_SECRET.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Public SDK keys the native app starts RevenueCat with (appl_… / goog_…).
REVENUECAT_PUBLIC_KEY_IOS=
REVENUECAT_PUBLIC_KEY_ANDROID=
