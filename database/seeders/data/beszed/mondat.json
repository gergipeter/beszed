[
  {"level": 1, "payload": {"text": "A cica alszik."}},
  {"level": 1, "payload": {"text": "A kutya ugat."}},
  {"level": 1, "payload": {"text": "A madár repül."}},
  {"level": 1, "payload": {"text": "Anya almát vesz."}},
  {"level": 1, "payload": {"text": "Apa autót vezet."}},
  {"level": 1, "payload": {"text": "A baba nevet."}},
  {"level": 1, "payload": {"text": "A nap süt."}},
  {"level": 1, "payload": {"text": "Az eső esik."}},
  {"level": 1, "payload": {"text": "A hal úszik."}},
  {"level": 1, "payload": {"text": "Zoé labdázik ma."}},
  {"level": 2, "payload": {"text": "A kis cica alszik."}},
  {"level": 2, "payload": {"text": "Anya piros almát vesz."}},
  {"level": 2, "payload": {"text": "A nagy kutya ugat."}},
  {"level": 2, "payload": {"text": "Zoé a parkban játszik."}},
  {"level": 2, "payload": {"text": "Apa friss kenyeret hoz."}},
  {"level": 2, "payload": {"text": "A madarak magasan repülnek."}},
  {"level": 2, "payload": {"text": "A vonat gyorsan megy."}},
  {"level": 2, "payload": {"text": "A gyerekek együtt énekelnek."}},
  {"level": 2, "payload": {"text": "A tehén tejet ad."}},
  {"level": 1, "payload": {"text": "Esténként mesét hallgatok."}},
  {"level": 3, "payload": {"text": "Kis békák ugrálnak a tóban."}},
  {"level": 3, "payload": {"text": "Anya sütit süt a konyhában."}},
  {"level": 3, "payload": {"text": "Apa és Zoé labdával játszik."}},
  {"level": 3, "payload": {"text": "Piros labdával játszunk a kertben."}},
  {"level": 3, "payload": {"text": "Reggel az oviba megyünk busszal."}},
  {"level": 3, "payload": {"text": "Nagy hó esik a hegyen."}},
  {"level": 3, "payload": {"text": "A kisfiú sárga biciklin ül."}},
  {"level": 3, "payload": {"text": "Nyáron fagylaltot eszünk a strandon."}},
  {"level": 1, "payload": {"text": "Anya ebédet főz."}},
  {"level": 1, "payload": {"text": "Apa könyvet olvas."}},
  {"level": 1, "payload": {"text": "A kisfiú rajzol."}},
  {"level": 1, "payload": {"text": "A kislány táncol."}},
  {"level": 1, "payload": {"text": "Zoé almát eszik."}},
  {"level": 1, "payload": {"text": "A tehén legel."}},
  {"level": 1, "payload": {"text": "A ló vágtat."}},
  {"level": 1, "payload": {"text": "A béka ugrik."}},
  {"level": 1, "payload": {"text": "A kacsa úszik."}},
  {"level": 1, "payload": {"text": "Apa kenyeret vág."}},
  {"level": 1, "payload": {"text": "A gyerek alszik."}},
  {"level": 1, "payload": {"text": "Anya mesét mond."}},
  {"level": 1, "payload": {"text": "A virág nyílik."}},
  {"level": 1, "payload": {"text": "A hó esik."}},
  {"level": 1, "payload": {"text": "A szél fúj."}},
  {"level": 1, "payload": {"text": "A busz megáll."}},
  {"level": 1, "payload": {"text": "Zoé vizet iszik."}},
  {"level": 1, "payload": {"text": "Apa levest főz."}},
  {"level": 1, "payload": {"text": "A cipő kicsi."}},
  {"level": 1, "payload": {"text": "Mi sétálunk ma."}},
  {"level": 1, "payload": {"text": "A csiga mászik."}},
  {"level": 1, "payload": {"text": "A méhecske zümmög."}},
  {"level": 1, "payload": {"text": "Zoé kezet mos."}},
  {"level": 1, "payload": {"text": "A tó csendes."}},
  {"level": 2, "payload": {"text": "A baba tejet iszik."}},
  {"level": 2, "payload": {"text": "Anya meleg levest főz."}},
  {"level": 2, "payload": {"text": "Apa új autót vezet."}},
  {"level": 2, "payload": {"text": "A kutya csontot rág."}},
  {"level": 2, "payload": {"text": "A cica tejet nyalogat."}},
  {"level": 2, "payload": {"text": "A kisfiú labdát rúg."}},
  {"level": 2, "payload": {"text": "Zoé szép képet rajzol."}},
  {"level": 2, "payload": {"text": "A madár fán ül."}},
  {"level": 2, "payload": {"text": "A hal vízben úszik."}},
  {"level": 2, "payload": {"text": "A méhek virágon zümmögnek."}},
  {"level": 2, "payload": {"text": "Anya friss süteményt süt."}},
  {"level": 2, "payload": {"text": "A tehenek füvet legelnek."}},
  {"level": 2, "payload": {"text": "Mi együtt építünk várat."}},
  {"level": 2, "payload": {"text": "A kis béka ugrik."}},
  {"level": 2, "payload": {"text": "Apa piros autót mos."}},
  {"level": 2, "payload": {"text": "A nap fényesen süt."}},
  {"level": 2, "payload": {"text": "Zoé puha mackót ölel."}},
  {"level": 2, "payload": {"text": "A ló gyorsan fut."}},
  {"level": 2, "payload": {"text": "A kacsa tóban úszik."}},
  {"level": 2, "payload": {"text": "Anya szép ruhát vesz."}},
  {"level": 2, "payload": {"text": "A kisautó lassan gurul."}},
  {"level": 2, "payload": {"text": "A vonat állomáson áll."}},
  {"level": 2, "payload": {"text": "Apa nagy fát ültet."}},
  {"level": 3, "payload": {"text": "A kislány piros ruhát hord."}},
  {"level": 3, "payload": {"text": "Zoé homokvárat épít a parton."}},
  {"level": 3, "payload": {"text": "Anya kenyeret vesz a boltban."}},
  {"level": 3, "payload": {"text": "Apa autóval megy a munkába."}},
  {"level": 3, "payload": {"text": "Nagy kutya fut a kertben."}},
  {"level": 3, "payload": {"text": "Kis madár ül az ágon."}},
  {"level": 3, "payload": {"text": "Sok gyerek játszik a parkban."}},
  {"level": 3, "payload": {"text": "Zoé meleg teát iszik este."}},
  {"level": 3, "payload": {"text": "Apa fát ültet a kertben."}},
  {"level": 3, "payload": {"text": "Reggel tejet iszunk a konyhában."}},
  {"level": 3, "payload": {"text": "Kis hal úszik a tóban."}},
  {"level": 3, "payload": {"text": "Zoé piros sapkát vesz fel."}},
  {"level": 3, "payload": {"text": "A cica meleg ágyban alszik."}},
  {"level": 3, "payload": {"text": "Kék madár repül az égen."}},
  {"level": 3, "payload": {"text": "Anya és apa sétál ma."}},
  {"level": 3, "payload": {"text": "Zoé és anya mesét olvasnak."}},
  {"level": 3, "payload": {"text": "A kisfiú zöld békát talált."}},
  {"level": 3, "payload": {"text": "Télen vastag kabátot veszünk fel."}},
  {"level": 3, "payload": {"text": "Tavasszal a fán madarak énekelnek."}},
  {"level": 3, "payload": {"text": "Ősszel sárga levelek hullnak le."}},
  {"level": 3, "payload": {"text": "Piros bogár mászik a falon."}},
  {"level": 3, "payload": {"text": "Zoé és apa focizni mennek."}},
  {"level": 3, "payload": {"text": "Nagy elefánt iszik a folyóból."}},
  {"level": 3, "payload": {"text": "Este a gyerekek fogat mosnak."}},
  {"level": 3, "payload": {"text": "Délben a család ebédet eszik."}}
]
