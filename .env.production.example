# Copy to .env.production and fill in. Used by compose.prod.yaml (never commit the real file).

# Your domain; its DNS must point at this server. Caddy fetches the HTTPS certificate for it.
SERVER_NAME=beszed.example.hu
APP_URL=https://beszed.example.hu
SANCTUM_STATEFUL_DOMAINS=beszed.example.hu

APP_NAME="Beszéd & DIFER"
# Required. Generate: docker run --rm dunglas/frankenphp:1-php8.4 php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Parent sign-in. Google Cloud Console → Credentials → OAuth client ID ("Web application"),
# authorized redirect URI: https://beszed.example.hu/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shown on the privacy page (/adatvedelem).
PRIVACY_CONTROLLER="Példa Kft."
PRIVACY_CONTACT=adatvedelem@example.hu

# Parents (by Google e-mail, comma-separated) who may use the content editor (/tartalom).
ADMIN_EMAILS=

# Optional Azure voice (TTS) and pronunciation assessment (STT).
# piper = free voice on this server (built into the image), azure = Azure Speech, null = browser voice
TTS_DRIVER=piper
STT_DRIVER=null
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=hu-HU-NoemiNeural

# E-mail: the Sunday weekly report (HTML + PDF) and milestone notes. Any SMTP works
# (e.g. Brevo, Mailgun, Resend, or a Gmail app password).
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=csillam@beszed.example.hu
MAIL_FROM_NAME="Csillám"
