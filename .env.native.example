# Settings of the iOS / Android app's web build (npm run build:native, docs/native-app.md).
# Copy to .env.native (git-ignored) or set these in the environment. Only VITE_* values are read, and they end up in the
# app's files: no secrets here.

# REQUIRED. The server the app talks to: the origin of this site's production URL, https, no path, no trailing slash.
# (Not the app's own origin: the shell is served as https://app.beszed.local / capacitor://app.beszed.local, and the
# server's CORS list, config/cors.php, already has those.)
VITE_API_ORIGIN=https://beszed.example.hu

# The in-app privacy notice (/adatvedelem) and terms show these. Keep them equal to the server's .env
# (PRIVACY_CONTROLLER, PRIVACY_CONTACT, PRIVACY_VERSION, STT_DRIVER, TTS_DRIVER); the build warns while they are unset.
VITE_PRIVACY_CONTROLLER="Példa Kft., 1234 Budapest, Minta utca 1."
VITE_PRIVACY_CONTACT=adatvedelem@example.hu
VITE_PRIVACY_VERSION=2026-09
VITE_STT_DRIVER=null
VITE_TTS_DRIVER=piper

# Optional: the heading on the sign-in page (default: the server's APP_NAME, "Beszéd & DIFER").
# VITE_APP_NAME="Beszéd & DIFER"
